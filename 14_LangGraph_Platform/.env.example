# Environment configuration for LangGraph Platform

# Required for OpenAI-powered models/tools
OPENAI_API_KEY=

# Optional: override the chat model used by agents
OPENAI_MODEL=gpt-4.1-nano
OPENAI_CHAT_MODEL=gpt-4.1-nano

# Optional: Tavily search (used by TavilySearchResults tool)
TAVILY_API_KEY=

# Optional: LangSmith for tracing/Studio (if you use it)
LANGSMITH_API_KEY=

# RAG data directory (relative to repo root)
RAG_DATA_DIR=data
